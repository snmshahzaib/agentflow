# Production environment template.
#
#   cp deploy/.env.production.example .env      (on the host, never committed)
#
# Fill every __PLACEHOLDER__. The application refuses to start in production
# with the development session secret, and refuses a model that is not in the
# provider catalogue, so a half-filled file fails at boot rather than at the
# first request.

# -----------------------------------------------------------------------------
# Identity
# -----------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json

# The public hostname. Caddy obtains a certificate for exactly this name.
DEPLOY_DOMAIN=__YOUR_DOMAIN__

# The browser reaches one origin, so this is the same host over https.
CORS_ALLOW_ORIGINS=https://__YOUR_DOMAIN__

# -----------------------------------------------------------------------------
# Data services -- NOT reachable from the internet
# -----------------------------------------------------------------------------
# The leading 127.0.0.1 is load-bearing. A Docker published port is a DNAT
# rule, so it bypasses a host firewall that only filters INPUT: without the
# bind address these would be open to the world on a public VM. Compose
# substitutes the whole string, so "127.0.0.1:5433" becomes
# "127.0.0.1:5433:5432".
POSTGRES_HOST_PORT=127.0.0.1:5433
REDIS_HOST_PORT=127.0.0.1:6380
# The API and frontend are reached only through Caddy, so they bind to
# localhost too. Verified with `docker compose config`: without the prefix
# the overlay leaves 0.0.0.0:8000 published alongside the localhost binding,
# because compose merges port lists rather than replacing them.
API_PORT=127.0.0.1:8000
FRONTEND_PORT=127.0.0.1:8080

POSTGRES_USER=agentflow
POSTGRES_PASSWORD=__GENERATE_WITH_openssl_rand_base64_32__
POSTGRES_DB=agentflow

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# openssl rand -hex 32
SESSION_SECRET=__GENERATE_WITH_openssl_rand_hex_32__

# Gates live research. Without it, every visitor -- including you -- gets the
# deterministic offline profile. Generate one and keep it out of the repo:
#   openssl rand -hex 16
DEMO_ACCESS_CODE=__GENERATE_WITH_openssl_rand_hex_16__

# -----------------------------------------------------------------------------
# Providers
# -----------------------------------------------------------------------------
# Leave LLM_PROVIDER=stub and SEARCH_PROVIDER=fixture for a zero-cost public
# demo: the full workflow runs, nothing is spent, and no credential exists on
# the host to leak. Set them only when live research is wanted, and only
# alongside DEMO_ACCESS_CODE.
LLM_PROVIDER=stub
SEARCH_PROVIDER=fixture

# LLM_API_KEY=__OPENROUTER_KEY__
# SEARCH_API_KEY=__TAVILY_KEY__
# LLM_MODEL_DEFAULT=__A_FREE_MODEL_ID__

# Non-negotiable on a public deployment. Free-only refuses any model with
# non-zero published pricing; deny opts out of provider training.
LLM_FREE_MODELS_ONLY=true
LLM_DATA_COLLECTION=deny
LLM_REQUIRE_STRUCTURED_OUTPUT=true

# -----------------------------------------------------------------------------
# Demo ceilings -- enforced at admission
# -----------------------------------------------------------------------------
DEMO_DAILY_BUDGET_USD=2.00
DEMO_DAILY_TASK_LIMIT=100
DEMO_MAX_TASKS_PER_SESSION=3
RATE_LIMIT_PER_MINUTE=10

# Visitor research content is deleted after this many days.
DATA_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Workload
# -----------------------------------------------------------------------------
WORKER_MAX_CONCURRENT_TASKS=2
LLM_MAX_TOKENS_PER_TASK=120000
LLM_MAX_CALLS_PER_TASK=12
SEARCH_MAX_PER_TASK=8
