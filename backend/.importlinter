[importlinter]
root_packages =
    app
include_external_packages = True

[importlinter:contract:layers]
name = Layered architecture
type = layers
# app.api and app.workers are peers and must not import each other: the API
# enqueues work, the worker executes it, and they communicate through Redis
# and the database rather than in-process. app.graph sits below app.workers
# because the worker drives the graph, never the reverse.
layers =
    app.api | app.workers
    app.graph
    app.services
    app.db
    app.domain
exhaustive = False

[importlinter:contract:domain-is-framework-free]
name = Domain is framework-free
type = forbidden
source_modules = app.domain
forbidden_modules =
    fastapi
    sqlalchemy
    arq
    langgraph
    openai
    httpx
    redis
    app.db
    app.api
    app.services
    app.adapters
    app.graph
    app.workers

[importlinter:contract:adapters-depend-only-on-domain-and-core]
name = Adapters depend only on domain and core
type = forbidden
source_modules = app.adapters
forbidden_modules =
    app.api
    app.db
    app.services
    app.graph
    app.workers

[importlinter:contract:vendor-sdks-are-confined-to-adapters]
name = Vendor SDKs are confined to adapters
type = forbidden
# allow_indirect_imports: the rule is that no layer outside app.adapters may
# *use* a vendor SDK directly. Reaching one transitively is unavoidable and
# correct -- app.workers builds the LLM runtime, which is implemented by the
# adapter that wraps the SDK. Forbidding the indirect chain would only be
# satisfiable by hiding the dependency behind a lazy import, which makes the
# architecture less legible rather than more.
allow_indirect_imports = True
source_modules =
    app.api
    app.db
    app.domain
    app.services
    app.graph
    app.workers
forbidden_modules =
    openai
