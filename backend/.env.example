# =============================================================================
# AgentFlow backend — local development WITHOUT docker compose
#
#   cp backend/.env.example backend/.env
#
# Mirrors the root .env.example but points at services on localhost. When
# running under docker compose, the root .env is the only file you need.
# Full key documentation lives in ../.env.example.
# =============================================================================
APP_ENV=dev
LOG_LEVEL=debug
LOG_FORMAT=console
CORS_ALLOW_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://agentflow:__SET_A_LOCAL_DEV_PASSWORD__@localhost:5432/agentflow
REDIS_URL=redis://localhost:6379/0

# stub => no network and no API key required (default for tests and CI)
LLM_PROVIDER=stub
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=__SET_YOUR_OPENROUTER_API_KEY__
LLM_MODEL_DEFAULT=anthropic/claude-sonnet-5
LLM_MODEL_PLANNER=anthropic/claude-haiku-5.5
LLM_FALLBACK_MODELS=openai/gpt-5.1,google/gemini-4-argon
LLM_REQUIRE_STRUCTURED_OUTPUT=true

SEARCH_PROVIDER=fixture
SEARCH_API_KEY=__SET_YOUR_TAVILY_API_KEY__

SESSION_SECRET=__GENERATE_WITH_openssl_rand_hex_32__
