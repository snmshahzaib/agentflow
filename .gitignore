# ---------------------------------------------------------------------------
# Secrets and local configuration — NEVER commit real values.
# Only *.example files are tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.env
!example.env
secrets/
*.secret
*.secrets.*

# Credentials, keys, certificates
*.pem
*.key
!**/public*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*.ppk
.netrc
.npmrc
.pypirc
credentials
credentials.json
service-account*.json
gha-creds-*.json
.aws/
.gcloud/
gcloud-key*.json
.railway/
.vercel/
.fly/
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl

# Session / signing material
session_secret*
jwt_*.key

