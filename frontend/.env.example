# =============================================================================
# AgentFlow frontend — Vite environment
#
#   cp frontend/.env.example frontend/.env.local
#
# Only VITE_-prefixed variables reach the browser bundle. Never put a secret
# here: everything in this file is publicly readable in the shipped assets.
# =============================================================================

# Base URL of the AgentFlow API.
#   local dev (vite dev server proxies /api): leave empty
#   separate origin: https://agentflow-api.example.com
VITE_API_BASE_URL=

# Poll interval (ms) while a research task is active.
VITE_POLL_INTERVAL_MS=1500
