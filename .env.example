# =============================================================================
# AgentFlow — environment configuration (docker compose)
#
#   cp .env.example .env     then edit .env  (never commit .env)
#
# Every value below is a placeholder. No real credential belongs in this file
# or in any tracked file. See docs/model-configuration.md for the model matrix
# and docs/security.md for secret handling.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# dev | test | production — controls docs exposure, log format and strictness.
APP_ENV=dev
# debug | info | warning | error
LOG_LEVEL=info
# json | console   (console is human-readable for local work)
LOG_FORMAT=console
# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080

# -----------------------------------------------------------------------------
# PostgreSQL  (compose provisions this; override host for an external database)
# -----------------------------------------------------------------------------
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=__SET_A_LOCAL_DEV_PASSWORD__
POSTGRES_DB=agentflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full async DSN. Leave unset to have it assembled from the parts above.
# DATABASE_URL=postgresql+asyncpg://agentflow:password@postgres:5432/agentflow

# -----------------------------------------------------------------------------
# Redis  (arq queue, single-flight task locks, rate limiting)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# LLM gateway — provider-agnostic, OpenAI-compatible transport
#
# AgentFlow never hardcodes a model ID. Every model is resolved from the
# variables below at startup and validated against the provider catalogue.
#
# LLM_PROVIDER=stub       deterministic offline adapter. No network, no key.
#                         Default for tests, CI and offline development.
# LLM_PROVIDER=openrouter OpenRouter gateway (or any OpenAI-compatible endpoint
#                         reachable via LLM_BASE_URL: LiteLLM proxy, Azure
#                         OpenAI, Together, Groq, a local vLLM server, ...).
# -----------------------------------------------------------------------------
LLM_PROVIDER=stub
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=__SET_YOUR_OPENROUTER_API_KEY__

# Default model for every graph node. Verified against the live OpenRouter
# catalogue on 2026-11-15: 1,000,000 ctx, $2.00/$10.00 per 1M tokens,
# native structured outputs + tool calling.
LLM_MODEL_DEFAULT=anthropic/claude-sonnet-5

# Optional per-node overrides. Unset => LLM_MODEL_DEFAULT.
# The planner only decomposes a question into <=4 bounded subtasks, so a small
# fast model is sufficient. Verified 2026-11-15: 1,000,000 ctx,
# $0.10/$0.50 per 1M, native structured outputs.
LLM_MODEL_PLANNER=anthropic/claude-haiku-5.5
# LLM_MODEL_ANALYST=
# Precision-critical: this node protects the honesty guarantee. Keep it on a
# frontier model even when trimming cost elsewhere.
# LLM_MODEL_CITATION_CHECK=
# LLM_MODEL_DRAFT=

# Ordered fallback chain, tried when the primary model fails with a retryable
# error. Deliberately cross-vendor so an outage at one provider degrades model
# quality instead of failing the research task.
LLM_FALLBACK_MODELS=openai/gpt-5.1,google/gemini-4-argon

# Refuse models without native JSON-Schema enforcement rather than silently
# downgrading to prompt-coaxed JSON. Schema-constrained output is layer 3 of
# the prompt-injection boundary (docs/security.md) — keep this true in any
# environment that handles untrusted retrieved content.
LLM_REQUIRE_STRUCTURED_OUTPUT=true

# Reliability
LLM_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS=3
# deny | allow — refuse providers that may train on request data.
LLM_DATA_COLLECTION=deny
# Attribution headers sent to OpenRouter (optional, public values only).
LLM_APP_TITLE=AgentFlow
LLM_APP_URL=http://localhost:5173

# Per-task budget. Checked before every call; exhaustion fails the task
# cleanly rather than emitting a half-written report.
LLM_MAX_TOKENS_PER_TASK=120000
LLM_MAX_CALLS_PER_TASK=12

# -----------------------------------------------------------------------------
# Development profile: free models only
#
# Verified against the live catalogue on 2026-11-16. Of 469 models, 17 were
# genuinely free (every pricing field zero) and 7 of those advertised native
# structured outputs. Probing each with a real node schema
# (backend/scripts/probe_models.py) found three that actually honour a strict
# schema -- and the one below does so with our data_collection=deny privacy
# setting intact, so nothing has to be relaxed to use it.
#
# To use free models instead of the paid profile above, set:
#
#   LLM_PROVIDER=openrouter
#   LLM_FREE_MODELS_ONLY=true
#   LLM_MODEL_DEFAULT=baidu/ernie-5.5-flash-preview:free
#   LLM_MODEL_PLANNER=
#   LLM_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free,openrouter/free
#   LLM_MAX_ATTEMPTS=2
#   LLM_TIMEOUT_SECONDS=180
#
# Why those last two differ from the paid profile: free endpoints are
# rate-limited and slow. Measured latencies were 8-35 s per call against
# ~2-5 s for paid models, so the timeout is raised; and retries are reduced
# because retrying into a shared rate limit makes it worse for everyone.
#
# Free models are substantially weaker at analysis and citation checking, and
# their availability varies hour to hour. They are for development and for
# demonstrating the workflow without spend -- not for output anyone should
# rely on. Structured-output validation and every security control stay
# exactly as they are on the paid profile.

# -----------------------------------------------------------------------------
# Search provider
#
# SEARCH_PROVIDER=fixture  committed offline fixtures. Deterministic; the
#                          canonical demo path. No key required.
# SEARCH_PROVIDER=tavily   live web search (requires SEARCH_API_KEY).
# -----------------------------------------------------------------------------
SEARCH_PROVIDER=fixture
SEARCH_API_KEY=__SET_YOUR_TAVILY_API_KEY__
SEARCH_BASE_URL=https://api.tavily.com
SEARCH_MAX_RESULTS_PER_SUBTASK=5
SEARCH_TIMEOUT_SECONDS=20
SEARCH_MAX_ATTEMPTS=3
# "basic" costs 1 API credit against Tavily's free monthly allowance of 1,000;
# "advanced" costs 2. Nothing in this workflow needs advanced retrieval.
SEARCH_DEPTH=basic
# Ceiling on live searches per task, mirroring LLM_MAX_CALLS_PER_TASK. A free
# allowance is a shared, exhaustible resource: a runaway plan should cost one
# task rather than the month.
SEARCH_MAX_PER_TASK=8
# Comma-separated domains never to retrieve from.
SEARCH_EXCLUDE_DOMAINS=
#
# Live search, verified 2026-11-17 from Tavily's documentation:
#   1,000 API credits per month free, NO credit card required
#   basic search = 1 credit, advanced = 2
#   100 requests/minute on the free plan; 429 carries Retry-After
#   GET /usage reports plan_usage / plan_limit (metadata, costs no credit)
#
# Without a payment method on file, pay-as-you-go cannot be enabled, so
# exceeding the allowance returns an error rather than a bill. Check remaining
# credits with:  cd backend && uv run python scripts/search_usage.py
#
# To switch on live search:
#   SEARCH_PROVIDER=tavily
#   SEARCH_API_KEY=<your key>
#
# Fixture search stays the deterministic default. Every source records
# is_fixture individually, and a report's provenance notice is derived from
# the sources actually stored -- so a run that mixes live and fixture evidence
# says so rather than being described by its configuration.

# -----------------------------------------------------------------------------
# Orchestration limits
# -----------------------------------------------------------------------------
MAX_SUBTASKS=4
# Times a reviewer may send a report back. Each revision re-plans and
# re-retrieves, so an unbounded loop would be an unbounded spend.
MAX_REVISION_ROUNDS=3
WORKER_MAX_CONCURRENT_TASKS=2
NODE_MAX_ATTEMPTS=3
NODE_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Demo safety (public deployment)
# -----------------------------------------------------------------------------
# NOT YET ENFORCED -- the next three do nothing today. They are placeholders
# for the public deployment, and are listed as unimplemented in
# docs/security.md. Setting them does not limit anything.
#   intended: hard daily ceiling on estimated LLM spend, HTTP 429 over budget
DEMO_DAILY_BUDGET_USD=2.00
#   intended: cap on tasks one visitor may submit
DEMO_MAX_TASKS_PER_SESSION=5
#   intended: unlock live web search behind a shared code
DEMO_ACCESS_CODE=

# Enforced. Write endpoints (submit, approve, request revision) per session,
# per minute. Over the limit => HTTP 429 with Retry-After. Reads are not
# limited: polling is how the UI tracks progress.
RATE_LIMIT_PER_MINUTE=20
# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=__GENERATE_WITH_openssl_rand_hex_32__
# Enforced. Days before research tasks and everything belonging to them --
# sources, reports, claims -- are deleted. A worker cron runs the sweep daily.
DATA_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Host port mappings (compose)
# -----------------------------------------------------------------------------
API_PORT=8000
FRONTEND_PORT=8080
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
